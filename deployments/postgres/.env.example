# Copy to .env and fill in. .env is git-ignored; deploy.sh auto-loads it.
#
# Terraform reads TF_VAR_<name> environment variables to populate the
# matching input variables, so these feed var.client_id, var.token_url, etc.
# used by the provider block in provider.tf.

# --- Auth (vIAM service account) — REQUIRED ---
# Create a Service Account at https://iam.console.greennode.ai/service-accounts
# (Service account -> Create service account -> attach a vDB/vServer policy).
# The Secret Key is shown ONLY ONCE on creation — copy it then; regenerate from
# the account's Security credentials tab if lost.
TF_VAR_client_id=your-client-id
TF_VAR_client_secret=your-client-secret

# --- Platform endpoints (OPTIONAL — variables.tf already defaults these;
#     uncomment/override only if your tenant uses different hostnames) ---
TF_VAR_token_url=https://iamapis.vngcloud.vn/accounts-api/v2/auth/token
TF_VAR_vserver_base_url=https://hcm-3.api.vngcloud.vn/vserver/vserver-gateway
TF_VAR_vlb_base_url=https://hcm-3.api.vngcloud.vn/vserver/vlb-gateway
TF_VAR_vdb_base_url=https://vdb-gateway.vngcloud.vn
