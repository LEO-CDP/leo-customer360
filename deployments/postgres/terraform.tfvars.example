# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.
# SECRETS ONLY — non-secret, per-env config lives in overlays/<env>.tfvars.

# --- Auth (vIAM service account) ---
# Create at https://iam.console.greennode.ai/service-accounts (Secret shown once).
client_id     = "your-client-id"
client_secret = "your-client-secret"

# --- DB master password ---
db_password = "CHANGE_ME_Strong#123"
