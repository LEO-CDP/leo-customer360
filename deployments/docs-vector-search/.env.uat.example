# Document Vector Search — UAT (1 CPU / 2 GB). Copy to .env.uat and fill in. Keep out of git.

# Compose / container
ENVIRONMENT=uat
CONTAINER_NAME=docs-vector-search-uat
IMAGE_TAG=uat
API_PORT=8081

# vDB — UAT PostgreSQL 15 (pgvector). From deployments/postgres outputs.
PG_HOST=...
PG_PORT=5432
PG_DATABASE=...
PG_USER=...
PG_PASSWORD=...          # secret
PG_SCHEMA=rag

# Local models (weights live in ./models-uat, mounted at /app/models)
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_DIM=384
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base

# Retrieval / chunking
RETRIEVE_TOP_N=20
RERANK_TOP_K=5
CHUNK_TOKENS=400
CHUNK_OVERLAP=50
CONTEXT_CHAR_BUDGET=6000
