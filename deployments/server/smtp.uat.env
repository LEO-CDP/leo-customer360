# c360_uat_smtp — Brevo SMTP relay (UAT). NON-SECRET config, committed.
# The password is injected at deploy time from $BREVO_SMTP_PASSWORD (GH secret,
# for CI/CD) or from a git-ignored smtp.uat.local.env override (for local runs).
EMAIL_DISPATCH_ADAPTER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=tantrieuf31.database@gmail.com
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=tantrieuf31.database@gmail.com
EMAIL_FROM_NAME="LEO CDP"
