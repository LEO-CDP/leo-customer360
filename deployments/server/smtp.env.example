# Per-env SMTP / email-dispatch config for the DEPLOYED platform.
#
# smtp.<env>.env      : COMMITTED, NON-SECRET (host/port/username/from/adapter).
#                       Present => that env sends real email; absent => 'mock'
#                       (this is why prod stays mock — there is no smtp.prod.env).
# smtp.<env>.local.env : GIT-IGNORED local override for the password on local runs.
# $BREVO_SMTP_PASSWORD : GH secret injected by cd.yml for CI/CD deploys.
#
# Password precedence at deploy: BREVO_SMTP_PASSWORD > smtp.<env>.local.env > smtp.<env>.env
# Sourced by deploy-api.sh + deploy-backend.sh; also feeds GET /api/v1/metadata/smtp.
# Brevo: EMAIL_FROM_ADDRESS must be a Brevo-verified sender or sends bounce.
EMAIL_DISPATCH_ADAPTER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-login@example.com
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=your-verified-sender@example.com
EMAIL_FROM_NAME="LEO CDP"
