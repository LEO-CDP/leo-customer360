# Copy to .env and fill in. .env is git-ignored; deploy.sh auto-loads it.
#
# Terraform reads TF_VAR_<name> environment variables to populate the matching
# input variables, so these feed var.access_key / var.secret_key / etc.

# --- vStorage S3 keys — REQUIRED ---
# vStorage console -> IAM -> Service account -> vStorage credentials -> Create a
# S3 key. The Secret Key is shown ONLY ONCE on creation — copy it then.
TF_VAR_access_key=your-vstorage-access-key
TF_VAR_secret_key=your-vstorage-secret-key

# --- Endpoint / region (OPTIONAL — overlays already set these per env;
#     uncomment to override globally) ---
# TF_VAR_s3_endpoint=https://hcm03.vstorage.vngcloud.vn
# TF_VAR_region=hcm03
