# Copy to .env and fill in. .env is git-ignored; deploy.sh auto-loads it.
#
# REQUIRED even though this module's own secrets live in terraform.tfvars: the S3
# remote backend in backend.tf authenticates from the ENVIRONMENT, and `terraform
# init` reads the backend BEFORE any .tfvars file is loaded. Without these two,
# init fails with "No valid credential sources found" (and a confusing EC2 IMDS
# message, because the AWS SDK falls back to instance metadata).
#
# Same vStorage S3 key as every other module's .env — this is the credential for
# the state bucket, not for the VKS API.

# --- vStorage S3 keys for the Terraform state backend — REQUIRED ---
AWS_ACCESS_KEY_ID=your-vstorage-access-key
AWS_SECRET_ACCESS_KEY=your-vstorage-secret-key

# --- vIAM service account (OPTIONAL here — normally set in terraform.tfvars) ---
# Terraform reads TF_VAR_<name> to populate the matching input variable.
# TF_VAR_client_id=your-client-id
# TF_VAR_client_secret=your-client-secret
