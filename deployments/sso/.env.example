# Copy to .env and fill in. .env is git-ignored; deploy-sso.sh auto-loads it.

# Keycloak bootstrap admin password (REQUIRED). Username = keycloak_admin_user (overlay).
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_Keycloak#123456

# Test user password for the customer360 realm (used by bootstrap-realm.py + SSO checks).
KC_TEST_USER_PASSWORD=CHANGE_ME_TestUser#123456
# KEYCLOAK_CLIENT_SECRET is written here automatically by bootstrap-realm.py; deploy-api.sh
# reads it to wire customer360-api. Do not set it by hand.

# Optional: override the DB password Keycloak uses. If unset, deploy-sso.sh reads
# db_password from ../postgres/terraform.tfvars.
# TF_VAR_db_password=
