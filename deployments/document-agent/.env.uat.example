# AI Chat API — UAT (1 CPU / 2 GB). Copy to .env.uat and fill in. Keep out of git.

# Compose / container
ENVIRONMENT=uat
CONTAINER_NAME=ai-chat-api-uat
IMAGE_TAG=uat
API_PORT=8081

# OpenAI (chat + embeddings)
LEO_OPENAI_API_KEY=sk-...
LEO_OPENAI_MODEL_NAME=gpt-4.1
EMBED_MODEL=text-embedding-3-small

# Retrieval
TOP_K=6
HOPS=1
CONTEXT_CHAR_BUDGET=24000
