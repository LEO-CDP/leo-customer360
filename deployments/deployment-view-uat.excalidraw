      "updated": 1,
      "link": null,
      "locked": false,
      "text": "L4 Network Load Balancer  (VNG vLB)\nbeta.leocdp.com  →  103.245.254.29   ·   TCP passthrough (no TLS)\n:443 / :80 → Caddy      :3000 → Dagster\n:9443 → Portainer (direct TLS)   :19999 → Netdata (SSO)   :5050 → pgAdmin (direct)",
      "originalText": "L4 Network Load Balancer  (VNG vLB)\nbeta.leocdp.com  →  103.245.254.29   ·   TCP passthrough (no TLS)\n:443 / :80 → Caddy      :3000 → Dagster\n:9443 → Portainer (direct TLS)   :19999 → Netdata (SSO)   :5050 → pgAdmin (direct)",
      "fontSize": 12.5,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "lb",
      "lineHeight": 1.25,
      "autoResize": false
    },
