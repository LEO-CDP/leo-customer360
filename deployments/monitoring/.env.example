# cp .env.example .env — all values OPTIONAL. Everything works with none of these set.

# OPTIONAL: bootstrap Portainer's admin user non-interactively (>=12 chars). If set, the
# deploy writes it to a 0600 file on the box and passes --admin-password-file, so you
# skip the first-visit setup form (and dodge Portainer's setup-timeout lock). If unset,
# create the admin in the browser within a few minutes of first start.
# PORTAINER_ADMIN_PASSWORD=change-me-please

# --- oauth2-proxy (Keycloak SSO gate) — used by deploy-monitoring.sh ---
# Both are provisioned/generated automatically on first `./deploy-monitoring.sh <env>`:
#   OAUTH2_PROXY_CLIENT_SECRET  — created by bootstrap-oauth2-client.py (needs the KC admin
#                                 password; reused from ../sso/.env if not set here).
#   OAUTH2_PROXY_COOKIE_SECRET  — auto-generated once (openssl rand -base64 32) and appended.
# Set them by hand only to pin specific values.
# OAUTH2_PROXY_CLIENT_SECRET=
# OAUTH2_PROXY_COOKIE_SECRET=
# KEYCLOAK_ADMIN_PASSWORD=            # only needed to auto-provision the client; else in ../sso/.env

# OPTIONAL overrides (defaults shown):
# SSH_KEY=$HOME/.ssh/c360-api_ed25519
# BASTION_USER=leocdp360
