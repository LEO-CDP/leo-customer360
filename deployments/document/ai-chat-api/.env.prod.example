# AI Chat API — PROD (1 CPU / 2 GB). Copy to .env.prod and fill in. Keep out of git.

# Compose / container
ENVIRONMENT=prod
CONTAINER_NAME=ai-chat-api-prod
IMAGE_TAG=prod
API_PORT=8080

# OpenAI (chat + embeddings)
LEO_OPENAI_API_KEY=sk-...
LEO_OPENAI_MODEL_NAME=gpt-4.1
EMBED_MODEL=text-embedding-3-small

# Retrieval
TOP_K=6
HOPS=1
CONTEXT_CHAR_BUDGET=24000
