# =============================================================================
# Customer 360 Platform - consolidated configuration
# =============================================================================
#
# Copy this file to .env (same directory as docker-compose.yml) and adjust
# values for your environment.
#
# How this file is used:
#   1. docker-compose.yml uses it for variable substitution and container env
#      injection.
#   2. customer360-api and backend-system/identity_resolution read it directly
#      in local development via pydantic-settings / python-dotenv.
#
# Notes for operators:
#   - Keep the same variable names in .env and .env.example.
#   - DB_HOST / REDIS_HOST are overridden inside docker-compose to the internal
#     service names postgres / redis for containers on the shared network.
#   - Published host bindings default to loopback-only; change them only when
#     you need remote access.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Core infrastructure: PostgreSQL + Redis
# -----------------------------------------------------------------------------

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me_postgres_password
DB_NAME=customer360
DB_SCHEMA=customer360

# Published PostgreSQL host settings
POSTGRES_HOST_PORT=5432
POSTGRES_HOST_BIND=127.0.0.1

# Redis (used for API response caching and shared state)
REDIS_HOST=localhost
REDIS_PORT=6580
REDIS_DB=0
REDIS_PASSWORD=change_me_redis_password

# Published Redis host settings
REDIS_HOST_PORT=6580
REDIS_HOST_BIND=127.0.0.1

# Cache behavior
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60

# -----------------------------------------------------------------------------
# 2) Application runtime: SQLAlchemy + API
# -----------------------------------------------------------------------------

# SQLAlchemy connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
DB_ECHO_SQL=false

# Published API host settings
C360_API_DEFAULT_PAGE_SIZE=100
C360_API_MAX_PAGE_SIZE=1000
C360_API_HOST=0.0.0.0
C360_API_PORT=8008
UVICORN_RELOAD=false

# CDP data tracking API
C360_TRACKING_API_HOST=127.0.0.1
C360_TRACKING_API_PORT=8010
TRACKING_MAX_EVENTS_PER_REQUEST=1000
TRACKING_REDIS_KEY_PREFIX=data-tracking-api
TRACKING_SESSION_TTL_SECONDS=86400
TRACKING_RATE_LIMIT_REQUESTS=120
TRACKING_RATE_LIMIT_WINDOW_SECONDS=60
TRACKING_RATE_LIMIT_FAIL_OPEN=true
TRACKING_BOT_FILTER_ENABLED=true
TRACKING_BOT_USER_AGENT_PATTERNS=googlebot,bingbot,google-inspectiontool,ahrefsbot,semrushbot,petalbot

# Redis-backed brute-force throttling for POST /auth/login and repeated
# failed token validation (see customer360-api/core/utils/rate_limiter.py)
C360_AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
C360_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# 3) Frontend admin
# -----------------------------------------------------------------------------

# Browser-visible API endpoint used by the admin UI.
# Must be reachable from the browser; use the published host/port above.
# No /c360api suffix here: that prefix is only real behind a reverse proxy
# that strips it before forwarding to uvicorn (see app.py's root_path) --
# locally there's no such proxy, so the API only answers under /api/v1.
FRONTEND_API_HOSTNAME=http://localhost:8008
FRONTEND_TENANT_ID=11111111-1111-1111-1111-111111111111
FRONTEND_HOST_BIND=0.0.0.0
FRONTEND_HOST_PORT=8890
FRONTEND_UVICORN_RELOAD=false
FRONTEND_ROOT_PATH=  # Optional: change the root path for the frontend-admin static site.
LEO_OBSERVER_LOG_DOMAIN=datahub4uspa.leocdp.net
LEO_OBSERVER_CDN_DOMAIN=cdn.jsdelivr.net/gh/USPA-Technology/leo-cdp-static-files@v0.9.5

# -----------------------------------------------------------------------------
# 4) Background jobs / identity resolution
# -----------------------------------------------------------------------------

# Identity resolution worker
CIR_BATCH_SIZE=5000
CIR_POLL_INTERVAL_SECONDS=30

# Analytics data-source aggregation
ANALYTICS_DATA_SOURCE_LIMIT=10
ANALYTICS_LOCK_TTL_SECONDS=3600

# Dagster local UI / daemon
# Optional: set an absolute path if you want a persistent Dagster home.
# Leave unset to use backend-system/.dagster_home by default.
# DAGSTER_HOME=/absolute/path/to/leo-customer360/backend-system/.dagster_home
DAGSTER_UI_HOST=127.0.0.1
DAGSTER_UI_PORT=3000

# -----------------------------------------------------------------------------
# 5) Authentication / SSO
# -----------------------------------------------------------------------------

# Local development auth mode
SSO_LOGIN=false
DEFAULT_ROOT_USERNAME=admin
DEFAULT_ROOT_PASSWORD=change_me_root_password

# Local dev JWT settings (used when SSO_LOGIN=false)
DEV_JWT_SECRET=change_me_dev_jwt_secret_min_32_bytes_long
DEV_JWT_EXPIRES_MINUTES=480

# Keycloak / OpenID Connect
SSO_LOGIN_URL=http://localhost:8080
KEYCLOAK_REALM=leocdp
KEYCLOAK_CLIENT_ID=leocdp
KEYCLOAK_CLIENT_SECRET=change_me_keycloak_client_secret
KEYCLOAK_CALLBACK_URL=http://localhost:8008/auth/callback
KEYCLOAK_VERIFY_SSL=false



# -----------------------------------------------------------------------------
# 6) Local development services
# -----------------------------------------------------------------------------

# Keycloak container
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin_password
KEYCLOAK_HOST_PORT=8080
KEYCLOAK_HOST_BIND=127.0.0.1
KEYCLOAK_VERSION=26.7
KEYCLOAK_COMMAND=start-dev
KEYCLOAK_HOSTNAME=localhost

# MinIO container (development-only object storage)
MINIO_ROOT_USER=change_me_minio_root_user
MINIO_ROOT_PASSWORD=change_me_minio_root_password
MINIO_BUCKET=customer360-events-dev
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_HOST_BIND=127.0.0.1

# Object storage for data-tracking-api. dev-docker-compose.yml overrides these
# with the in-network MinIO endpoint. docker-compose.yml uses AWS S3 settings.
OBJECT_STORAGE_MODE=s3
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_AUTO_CREATE_BUCKETS=true

# -----------------------------------------------------------------------------
# 7) Generative AI
# -----------------------------------------------------------------------------

DEFAULT_GENAI_PROVIDER=google  # Options: openai, google

# Google Gemini
GOOGLE_GENAI_API_KEY=YOUR_GOOGLE_GENAI_API_KEY
GOOGLE_GENAI_MODEL=gemini-3.5-flash-lite

# OpenAI API keys and model names. Set these to your own values if you want to use the generative AI features.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_GENAI_MODEL=gpt-5.4-nano