# Customer 360 global environment
# Copy this file to .env and set real secrets and hostnames.
# Used by Docker Compose and local Python/shell services.
# Keep .env private; commit only this template.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me_postgres_password
DB_NAME=customer360
DB_SCHEMA=customer360

# Host-published PostgreSQL port
POSTGRES_HOST_PORT=5432
POSTGRES_HOST_BIND=127.0.0.1

# Redis
REDIS_HOST=localhost
REDIS_PORT=6580
REDIS_DB=0
REDIS_PASSWORD=change_me_redis_password

# Host-published Redis port
REDIS_HOST_PORT=6580
REDIS_HOST_BIND=127.0.0.1

# API response cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60

# SQLAlchemy pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
DB_ECHO_SQL=false

# API pagination and host port
API_DEFAULT_PAGE_SIZE=100
API_MAX_PAGE_SIZE=1000
C360_API_HOST=127.0.0.1
C360_API_PORT=8008
UVICORN_RELOAD=false

# Tracking API host port
C360_TRACKING_API_HOST=127.0.0.1
C360_TRACKING_API_PORT=8010
TRACKING_MAX_EVENTS_PER_REQUEST=1000
TRACKING_REDIS_KEY_PREFIX=data-tracking-api
TRACKING_SESSION_TTL_SECONDS=86400
TRACKING_RATE_LIMIT_REQUESTS=1000
TRACKING_RATE_LIMIT_WINDOW_SECONDS=360
TRACKING_RATE_LIMIT_FAIL_OPEN=true
TRACKING_BOT_FILTER_ENABLED=true
TRACKING_BOT_USER_AGENT_PATTERNS=googlebot,bingbot,google-inspectiontool,ahrefsbot,semrushbot,petalbot

# API login rate limit
C360_AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
C360_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Frontend browser API base; keep the public mount, not /api/v1.
FRONTEND_API_HOSTNAME=https://c360.example.com/c360api
FRONTEND_TENANT_ID=11111111-1111-1111-1111-111111111111
FRONTEND_HOST_BIND=127.0.0.1
FRONTEND_HOST_PORT=8890
FRONTEND_UVICORN_RELOAD=false
FRONTEND_ROOT_PATH=/c360
LEO_OBSERVER_LOG_DOMAIN=c360.example.com
LEO_OBSERVER_TRACKING_URI=/data/api/v1/tracking/logs
LEO_OBSERVER_TRACKING_ENDPOINT=https://c360.example.com/data/api/v1/tracking/logs
LEO_OBSERVER_CDN_JS=https://gcore.jsdelivr.net/gh/LEO-CDP/leo-customer360@main/data-tracking-api/static/c360-web-sdk/observer/leo.proxy.js

# Identity resolution
CIR_BATCH_SIZE=5000
CIR_POLL_INTERVAL_SECONDS=30

# Analytics aggregation
ANALYTICS_DATA_SOURCE_LIMIT=10
ANALYTICS_LOCK_TTL_SECONDS=3600

# Dagster local UI
# Optional: set an absolute persistent path.
# DAGSTER_HOME=/absolute/path/to/leo-customer360/backend-system/.dagster_home
DAGSTER_UI_HOST=127.0.0.1
DAGSTER_UI_PORT=3000

# Local authentication
SSO_LOGIN=false
DEFAULT_ROOT_USERNAME=admin
DEFAULT_ROOT_PASSWORD=change_me_root_password

# Local JWT; used when SSO_LOGIN=false
DEV_JWT_SECRET=change_me_dev_jwt_secret_min_32_bytes_long
DEV_JWT_EXPIRES_MINUTES=480

# Keycloak client
SSO_LOGIN_URL=https://c360.example.com/auth
KEYCLOAK_REALM=leocdp
KEYCLOAK_CLIENT_ID=leocdp
KEYCLOAK_CLIENT_SECRET=change_me_keycloak_client_secret
KEYCLOAK_CALLBACK_URL=https://c360.example.com/
KEYCLOAK_VERIFY_SSL=false



# Keycloak container
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin_password
KEYCLOAK_HOST_PORT=8080
KEYCLOAK_HOST_BIND=127.0.0.1
KEYCLOAK_VERSION=26.7
KEYCLOAK_COMMAND=start-dev
KEYCLOAK_HOSTNAME=https://c360.example.com/auth

# MinIO; development only
MINIO_ROOT_USER=change_me_minio_root_user
MINIO_ROOT_PASSWORD=change_me_minio_root_password
MINIO_BUCKET=customer360-events-dev
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_HOST_BIND=127.0.0.1

# Object storage; dev Compose overrides the endpoint for MinIO.
OBJECT_STORAGE_MODE=minio
S3_ENDPOINT_URL=https://c360.example.com/s3
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=change_me_minio_root_user
S3_SECRET_ACCESS_KEY=change_me_minio_root_password
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKETS=true

# Optional Gemini persona labels
LEO_GOOGLE_GENAI_API_KEY=YOUR_GOOGLE_GENAI_API_KEY
LEO_GOOGLE_GENAI_MODEL=gemini-3.5-flash-lite

# Optional OpenAI configuration
LEO_OPENAI_API_KEY=YOUR_OPENAI_API_KEY
LEO_OPENAI_MODEL_NAME=gpt-5.6-luna
LEO_OPENAI_BASE_URL=https://api.openai.com/v1