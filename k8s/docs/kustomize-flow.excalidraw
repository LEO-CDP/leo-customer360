    { "type": "text", "id": "d1_h_result", "x": 1250, "y": 150, "width": 400, "height": 20, "text": "RESULT · applied to cluster", "originalText": "RESULT · applied to cluster", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#3b82f6", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100005, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "base_rect", "x": 60, "y": 250, "width": 380, "height": 250, "strokeColor": "#1e40af", "backgroundColor": "#dbeafe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100010, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": [], "link": null, "locked": false, "roundness": {"type": 3} },
    { "type": "text", "id": "base_h", "x": 76, "y": 260, "width": 120, "height": 24, "text": "base/", "originalText": "base/", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100011, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "base_sub", "x": 76, "y": 286, "width": 340, "height": 16, "text": "app tier · env-agnostic · reused by both", "originalText": "app tier · env-agnostic · reused by both", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100012, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "base_body", "x": 76, "y": 310, "width": 350, "height": 180, "text": "namespace  +  config → ConfigMap c360-config\n\nDeployments (replicas:1):\n  api       FastAPI          :8008\n  frontend  admin SPA        :8890\n  dagster   orchestrator     :3000\n  cir       resolution worker\n  keycloak  SSO :8080  + db-init Job\ncommonLabels: part-of=customer360", "originalText": "namespace  +  config → ConfigMap c360-config\n\nDeployments (replicas:1):\n  api       FastAPI          :8008\n  frontend  admin SPA        :8890\n  dagster   orchestrator     :3000\n  cir       resolution worker\n  keycloak  SSO :8080  + db-init Job\ncommonLabels: part-of=customer360", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100013, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.35 },

    { "type": "rectangle", "id": "comp_rect", "x": 60, "y": 540, "width": 380, "height": 210, "strokeColor": "#b45309", "backgroundColor": "#fef3c7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100020, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": [], "link": null, "locked": false, "roundness": {"type": 3} },
    { "type": "text", "id": "comp_h", "x": 76, "y": 550, "width": 320, "height": 22, "text": "components/in-cluster-data/", "originalText": "components/in-cluster-data/", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100021, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "comp_sub", "x": 76, "y": 574, "width": 320, "height": 16, "text": "self-contained data tier · opt-in", "originalText": "self-contained data tier · opt-in", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100022, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "comp_body", "x": 76, "y": 600, "width": 350, "height": 130, "text": "StatefulSets:\n  postgres  :5432   PVC 5Gi\n  redis     :6580   PVC 1Gi\n  kafka     :9092   PVC 2Gi\nminio (Deployment) :9000/:9001 PVC 5Gi\nJobs: minio-init · cir-demo-seed", "originalText": "StatefulSets:\n  postgres  :5432   PVC 5Gi\n  redis     :6580   PVC 1Gi\n  kafka     :9092   PVC 2Gi\nminio (Deployment) :9000/:9001 PVC 5Gi\nJobs: minio-init · cir-demo-seed", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100023, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.35 },

    { "type": "rectangle", "id": "vks_rect", "x": 640, "y": 175, "width": 440, "height": 210, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100030, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": [], "link": null, "locked": false, "roundness": {"type": 3} },
    { "type": "text", "id": "vks_h", "x": 656, "y": 185, "width": 260, "height": 24, "text": "overlays/vks/", "originalText": "overlays/vks/", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100031, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "vks_sub", "x": 656, "y": 211, "width": 400, "height": 16, "text": "managed data tier · prod-like", "originalText": "managed data tier · prod-like", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#065f46", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100032, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "vks_body", "x": 656, "y": 235, "width": 410, "height": 130, "text": "resources:  ../../base  +  ingress.yaml\npatches:    patch-config.yaml\nimages:     → container registry (:latest)\nsecret:     secret.env (match managed pwds)\ncomponent:  none  (data tier is managed)", "originalText": "resources:  ../../base  +  ingress.yaml\npatches:    patch-config.yaml\nimages:     → container registry (:latest)\nsecret:     secret.env (match managed pwds)\ncomponent:  none  (data tier is managed)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100033, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.35 },

    { "type": "rectangle", "id": "local_rect", "x": 640, "y": 470, "width": 440, "height": 250, "strokeColor": "#c2410c", "backgroundColor": "#fed7aa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100040, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": [], "link": null, "locked": false, "roundness": {"type": 3} },
    { "type": "text", "id": "local_h", "x": 656, "y": 482, "width": 280, "height": 24, "text": "overlays/local/", "originalText": "overlays/local/", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#c2410c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100041, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "local_sub", "x": 656, "y": 508, "width": 400, "height": 16, "text": "in-cluster data · kind", "originalText": "in-cluster data · kind", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#9a3412", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100042, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "local_body", "x": 656, "y": 534, "width": 410, "height": 150, "text": "resources:  ../../base\ncomponent:  in-cluster-data  ← adds data tier\npatches:    patch-nodeports · patch-resources\nimages:     :local  (kind load)\nsecret:     secret.env (dev values · SSO off)", "originalText": "resources:  ../../base\ncomponent:  in-cluster-data  ← adds data tier\npatches:    patch-nodeports · patch-resources\nimages:     :local  (kind load)\nsecret:     secret.env (dev values · SSO off)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100043, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.35 },

    { "type": "rectangle", "id": "vksout_rect", "x": 1250, "y": 175, "width": 430, "height": 210, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100050, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": [], "link": null, "locked": false, "roundness": {"type": 3} },
    { "type": "text", "id": "vksout_h", "x": 1266, "y": 187, "width": 300, "height": 22, "text": "GreenNode VKS", "originalText": "GreenNode VKS", "fontSize": 17, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100051, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "vksout_body", "x": 1266, "y": 220, "width": 400, "height": 150, "text": "app-tier pods only\nIngress + TLS → public hostnames\nSSO_LOGIN = true\n→ managed vDB (PG · Redis · Kafka)\n   + vStorage S3   (../terraform)", "originalText": "app-tier pods only\nIngress + TLS → public hostnames\nSSO_LOGIN = true\n→ managed vDB (PG · Redis · Kafka)\n   + vStorage S3   (../terraform)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#065f46", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100052, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.35 },

    { "type": "rectangle", "id": "localout_rect", "x": 1250, "y": 470, "width": 430, "height": 250, "strokeColor": "#c2410c", "backgroundColor": "#fed7aa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100060, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": [], "link": null, "locked": false, "roundness": {"type": 3} },
    { "type": "text", "id": "localout_h", "x": 1266, "y": 482, "width": 380, "height": 22, "text": "kind cluster · customer360", "originalText": "kind cluster · customer360", "fontSize": 17, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#c2410c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100061, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "localout_body", "x": 1266, "y": 515, "width": 400, "height": 180, "text": "app tier + data tier pods\nNodePorts → localhost:\n  :8008 api      :8890 frontend\n  :8080 keycloak   :3000 dagster\n  :9000/:9001 minio\nSSO_LOGIN = false  (header auth)", "originalText": "app tier + data tier pods\nNodePorts → localhost:\n  :8008 api      :8890 frontend\n  :8080 keycloak   :3000 dagster\n  :9000/:9001 minio\nSSO_LOGIN = false  (header auth)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#9a3412", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100062, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.35 },

