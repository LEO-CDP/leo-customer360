    { "type": "text", "id": "t_title", "x": 40, "y": 34, "width": 1000, "height": 38, "text": "Customer360 on Kubernetes — runtime (pod) view · local overlay", "originalText": "Customer360 on Kubernetes — runtime (pod) view · local overlay", "fontSize": 28, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200001, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "t_sub", "x": 40, "y": 80, "width": 1200, "height": 40, "text": "Namespace customer360 on a kind cluster. Every app pod gets envFrom c360-config (ConfigMap) + c360-secrets (Secret);\ndata pods read their DB / Redis / MinIO credentials from the same Secret. Arrows show runtime traffic, not build-time wiring.", "originalText": "Namespace customer360 on a kind cluster. Every app pod gets envFrom c360-config (ConfigMap) + c360-secrets (Secret);\ndata pods read their DB / Redis / MinIO credentials from the same Secret. Arrows show runtime traffic, not build-time wiring.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200002, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.35 },

