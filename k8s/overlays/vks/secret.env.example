# Copy to secret.env (gitignored). On VKS these must MATCH the managed services
# you provisioned with ../../../terraform.
DB_PASSWORD=SAME_AS_terraform_pg_password
REDIS_PASSWORD=SAME_AS_terraform_redis_password
KEYCLOAK_ADMIN_PASSWORD=change_me_admin
KEYCLOAK_CLIENT_SECRET=from_keycloak_leocdp_client
# vStorage S3 key (IAM console -> Service Account -> Create S3 key) - the app's
# S3 client uses these against S3_ENDPOINT:
MINIO_ROOT_USER=vstorage_s3_access_key
MINIO_ROOT_PASSWORD=vstorage_s3_secret_key
GOOGLE_GENAI_API_KEY=
