# Copy to secret.env (gitignored) and set values. Consumed by the c360-secrets
# secretGenerator. These are LOCAL dev secrets - pick anything.
DB_PASSWORD=change_me_pg_password
REDIS_PASSWORD=change_me_redis_password
KEYCLOAK_ADMIN_PASSWORD=change_me_admin
# Only needed when you configure SSO_LOGIN=true + the leocdp realm/client:
KEYCLOAK_CLIENT_SECRET=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
# Optional (GenAI features); leave blank to disable:
GOOGLE_GENAI_API_KEY=
