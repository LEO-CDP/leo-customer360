# Secret values for the backup CronJob / sidecar. DO NOT COMMIT REAL VALUES.
#
# Kubernetes — create the Secret from this file (fill in real values first):
#   kubectl create secret generic postgres-backup-secrets \
#     --from-env-file=backup-secret.env -n <app-namespace>
#
# Docker Compose — put these (renamed with the BACKUP_S3_* keys used in
# docker-compose.backup.yml) into the stack's .env instead.

# --- Database ---
# Master password for PGUSER (matches DB_PASSWORD in the app secret).
PGPASSWORD=CHANGE_ME

# --- vStorage / S3 offload ---
# vStorage S3 key pair (VNG IAM / vStorage console). These are the
# TF_VAR_vstorage_access_key / _secret_key equivalents — keep them OUT of git.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=us-east-1
