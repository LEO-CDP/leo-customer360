MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# API-only fresh traffic seed
TRACKING_API_URL=https://c360.example.com/data/api/v1/tracking/logs
TRACKING_DATA_SOURCE_ID=15dc39d4-ae42-5c60-9c77-66f05dcae448
# dev-c360.sh seed-new-data uses this local endpoint unless overridden in the shell.
SEED_TRACKING_API_URL=https://c360.example.com/data/api/v1/tracking/logs
SEED_TRACKING_DATA_SOURCE_ID=15dc39d4-ae42-5c60-9c77-66f05dcae448
NEW_DATA_EVENT_COUNT=20000
NEW_DATA_LOOKBACK_HOURS=720
SEED_EVENTS_PER_SESSION=20
SEED_API_CONCURRENCY=4
SEED_PROFILE_COUNT=1000
TRACKING_REQUEST_TIMEOUT_SECONDS=10
SEED_QUEUE_DRAIN_TIMEOUT_SECONDS=180
SEED_QUEUE_POLL_INTERVAL_SECONDS=2

# UAT anonymous web traffic simulator
