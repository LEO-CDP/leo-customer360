-- Idempotent creation of the non-superuser application role that Row-Level
-- Security depends on. Connecting as a superuser BYPASSES RLS entirely, so the
-- Customer360 API and workers must connect as this role.
--
-- Rendered by Terraform: ${app_role} / ${schema} are substituted at plan time.

DO $BODY$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '${app_role}') THEN
    CREATE ROLE "${app_role}" LOGIN PASSWORD '${app_password}';
  ELSE
    ALTER ROLE "${app_role}" WITH LOGIN PASSWORD '${app_password}';
  END IF;
END
$BODY$;

GRANT USAGE ON SCHEMA "${schema}" TO "${app_role}";
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA "${schema}" TO "${app_role}";
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA "${schema}" TO "${app_role}";

-- Ensure future tables/sequences are reachable too.
ALTER DEFAULT PRIVILEGES IN SCHEMA "${schema}" GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO "${app_role}";
ALTER DEFAULT PRIVILEGES IN SCHEMA "${schema}" GRANT USAGE, SELECT ON SEQUENCES TO "${app_role}";
