#!/usr/bin/env bash
# Rendered by Terraform (db-bootstrap module). PGPASSWORD is supplied via the
# provisioner environment, not baked into this script.
set -euo pipefail

PSQL=(psql -v ON_ERROR_STOP=1 -h '${host}' -p '${port}' -U '${master_user}' -d '${db_name}')

%{ if create_keycloak_db ~}
echo "[db-bootstrap] 0/5 ensuring the Keycloak database exists (idempotent)..."
# CREATE DATABASE cannot run inside a transaction/DO block; the script uses the
# psql \gexec trick guarded by pg_database, so re-runs are a no-op.
"$${PSQL[@]}" -f '${keycloak_db_sql}'

%{ endif ~}
echo "[db-bootstrap] 1/5 enabling extensions..."
"$${PSQL[@]}" -f '${extensions_sql}'

echo "[db-bootstrap] 2/5 applying schema (idempotent)..."
"$${PSQL[@]}" -f '${schema_sql}'

echo "[db-bootstrap] 3/5 creating RLS application role ${app_role}..."
"$${PSQL[@]}" <<'APPROLE_SQL'
${app_role_sql}
APPROLE_SQL

echo "[db-bootstrap] 4/5 seeding core data (idempotent)..."
"$${PSQL[@]}" -f '${seed_sql}'

%{ for f in extra_sql ~}
echo "[db-bootstrap] extra: ${f}"
"$${PSQL[@]}" -f '${f}'
%{ endfor ~}

echo "[db-bootstrap] 5/5 done."
