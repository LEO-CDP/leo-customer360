# Terraform state (never commit - contains secrets)
*.tfstate
*.tfstate.*
.terraform/
crash.log
crash.*.log

# Secret var files (commit only the *.example)
terraform.tfvars
*.auto.tfvars
*.auto.tfvars.json

# Env-var credential files (commit only .env.example)
.env
.env.*
!.env.example

# CLI overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lock file IS committed on purpose (reproducible provider versions):
# .terraform.lock.hcl
