# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
# Prefer TF_VAR_* env vars (or a secrets manager) for all sensitive values in prod.

# --- vngcloud IAM ---
vng_client_id     = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
vng_client_secret = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# --- vStorage S3 key ---
vstorage_access_key  = "xxxxxxxxxxxxxxxxxxxx"
vstorage_secret_key  = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
vstorage_region      = "hcm03"
vstorage_s3_endpoint = "https://hcm03.vstorage.vngcloud.vn"

# --- Account / project ---
vserver_project_id = "pro-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
zone_id            = "HCM03-1A"

# --- Networking: existing prod VPC, restricted ingress ---
network_id             = "net-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
subnet_id              = "sub-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
db_allowed_ip_prefixes = ["10.76.0.0/16"] # your app subnet(s) only

# --- Service credentials ---
pg_password    = "CHANGE_ME_strong_pg_password"
redis_password = "CHANGE_ME_strong_redis_password"

# --- Tenants ---
tenants = [
  { id = "11111111-1111-1111-1111-111111111111", code = "default" },
  # { id = "22222222-2222-2222-2222-222222222222", code = "acme" },
]

# --- Sizing (confirm exact package names in the vDB console) ---
# pg_package_name    = "vdb.s-general-2x4"
# pg_cluster_nodes   = 3
# redis_package_name = "db.new.s-general-2x4"
# kafka_package_name = "db-kafka.s-general-2x4-n10"
# kafka_broker_count = 3

# --- PG cluster backups (VNG Backup Center / vBackup) ---
# The HA cluster has NO backup_auto/duration/time. Create a Backup Policy +
# Location in Backup Center and paste their IDs here to enable automatic
# backups. Leaving these unset => manual snapshots + logical CronJob only.
# pg_backup_policy_id   = "bkpol-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# pg_backup_location_id = "bkloc-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
