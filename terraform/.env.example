# =============================================================================
# Terraform credentials for GreenNode / VNG Cloud (Customer360 infra)
# =============================================================================
# Terraform automatically reads any environment variable named TF_VAR_<name> as
# the value of input variable <name>. So exporting these is equivalent to putting
# them in terraform.tfvars - but nothing is written to disk in the state dir.
#
# USAGE
#   cp .env.example .env          # then fill in the real values
#   # --- bash / Git Bash ---
#   set -a; source .env; set +a   # export everything, then:
#   cd environments/dev && terraform plan
#   # --- PowerShell ---  (source doesn't work; set each instead, e.g.)
#   #   $env:TF_VAR_vng_client_id = "..."   ($env vars last only for the session)
#
# .env is gitignored. NEVER commit real secrets. There are TWO independent
# credential sets: the vngcloud IAM pair (vDB + networking) and a separate
# vStorage S3 key (buckets), plus the service passwords you choose.
# =============================================================================

# --- vngcloud IAM (drives all vDB: Postgres/Redis/Kafka + networking) --------
# GreenNode/VNG IAM console -> API credentials.
export TF_VAR_vng_client_id="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
export TF_VAR_vng_client_secret="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# --- vStorage S3 key (buckets; required if vstorage_enabled) ------------------
# IAM console -> Service Account -> Create S3 key. SECRET IS SHOWN ONLY ONCE.
export TF_VAR_vstorage_access_key="xxxxxxxxxxxxxxxxxxxx"
export TF_VAR_vstorage_secret_key="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Account / project -------------------------------------------------------
# vServer console. Required by Kafka and by network creation.
export TF_VAR_vserver_project_id="pro-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# --- Networking (required unless create_network=true) ------------------------
export TF_VAR_network_id="net-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
export TF_VAR_subnet_id="sub-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# --- Service passwords (you choose strong values) ----------------------------
export TF_VAR_pg_password="CHANGE_ME_strong_pg_password"
export TF_VAR_redis_password="CHANGE_ME_strong_redis_password"
# Only needed when run_db_bootstrap=true (non-superuser RLS role customer360_app).
# Avoid single quotes / backslashes in this value.
export TF_VAR_app_role_password="CHANGE_ME_strong_app_role_password"

# --- Optional: override only if your account is in a different region ---------
# export TF_VAR_zone_id="HCM03-1A"
# export TF_VAR_vstorage_region="hcm03"
# export TF_VAR_vstorage_s3_endpoint="https://hcm03.vstorage.vngcloud.vn"
# export TF_VAR_vng_token_url="https://iamapis.vngcloud.vn/accounts-api/v2/auth/token"
# export TF_VAR_vng_vdb_base_url="https://vdb-gateway.vngcloud.vn"
# export TF_VAR_vng_vserver_base_url="https://hcm-3.api.vngcloud.vn/vserver/vserver-gateway"
# export TF_VAR_vng_vlb_base_url="https://hcm-3.api.vngcloud.vn/vserver/vlb-gateway"
