    {"type":"text","id":"c5d","x":86,"y":780,"width":548,"height":40,"text":"config.py:224 / security.py:80 - SSO_LOGIN=false (default):\nmint a valid admin token for any tenant_id. Secret is in source.","originalText":"config.py:224 / security.py:80 - SSO_LOGIN=false (default):\nmint a valid admin token for any tenant_id. Secret is in source.","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#475569","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":100142,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.3},

