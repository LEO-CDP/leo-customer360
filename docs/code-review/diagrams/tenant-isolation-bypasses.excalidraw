    {"type":"text","id":"title","x":60,"y":24,"width":900,"height":38,"text":"Multi-Tenant Isolation: One Boundary, Seven Bypasses","originalText":"Multi-Tenant Isolation: One Boundary, Seven Bypasses","fontSize":30,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":100001,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"text","id":"subtitle","x":60,"y":72,"width":1120,"height":44,"text":"The platform's ONLY tenant boundary is PostgreSQL Row-Level Security keyed on current_setting('app.tenant_id').\nEach path below reaches Tenant A's data without RLS ever stopping it - it is skipped, absent, or aimed at the attacker's chosen tenant.","originalText":"The platform's ONLY tenant boundary is PostgreSQL Row-Level Security keyed on current_setting('app.tenant_id').\nEach path below reaches Tenant A's data without RLS ever stopping it - it is skipped, absent, or aimed at the attacker's chosen tenant.","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":100002,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.3},

