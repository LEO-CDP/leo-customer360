  "elements": [
    {"type":"text","id":"title","x":60,"y":24,"width":1100,"height":38,"text":"Identity Resolution: How Two Real People Become One Golden Record","originalText":"Identity Resolution: How Two Real People Become One Golden Record","fontSize":28,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200001,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"text","id":"subtitle","x":60,"y":70,"width":1180,"height":24,"text":"Matching ORs every available identifier with no minimum-confidence gate, so one shared weak signal merges distinct people - irreversibly.","originalText":"Matching ORs every available identifier with no minimum-confidence gate, so one shared weak signal merges distinct people - irreversibly.","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200002,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},

    {"type":"rectangle","id":"alice","x":60,"y":150,"width":362,"height":130,"strokeColor":"#6d28d9","backgroundColor":"#ddd6fe","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200010,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"alicet","x":78,"y":166,"width":330,"height":100,"text":"PERSON 1  -  Alice  (new raw profile)\n\nemail:      alice@example.com\ncookie_id:  C   (shared kiosk PC)","originalText":"PERSON 1  -  Alice  (new raw profile)\n\nemail:      alice@example.com\ncookie_id:  C   (shared kiosk PC)","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#4c1d95","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200011,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.35},

    {"type":"rectangle","id":"bob","x":60,"y":330,"width":362,"height":130,"strokeColor":"#047857","backgroundColor":"#a7f3d0","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200020,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"bobt","x":78,"y":346,"width":330,"height":100,"text":"PERSON 2  -  Bob  (existing master)\n\nphone:       +1 415 555 0000\ncookie_ids:  [ C, ... ]  (same kiosk)","originalText":"PERSON 2  -  Bob  (existing master)\n\nphone:       +1 415 555 0000\ncookie_ids:  [ C, ... ]  (same kiosk)","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#065f46","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200021,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.35},

    {"type":"text","id":"bridge","x":60,"y":476,"width":330,"height":48,"text":"Only overlap is cookie_id = C - a shared / reset\ndevice signal, NOT proof of the same person.","originalText":"Only overlap is cookie_id = C - a shared / reset\ndevice signal, NOT proof of the same person.","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#b45309","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200030,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.3},

    {"type":"rectangle","id":"engine","x":470,"y":190,"width":470,"height":300,"strokeColor":"#b45309","backgroundColor":"#fef3c7","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200040,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"enginet","x":490,"y":206,"width":430,"height":24,"text":"MATCHING ENGINE   (resolver.py)","originalText":"MATCHING ENGINE   (resolver.py)","fontSize":16,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#7c2d12","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200041,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"text","id":"engined","x":490,"y":244,"width":430,"height":230,"text":"WHERE cond1 OR cond2 OR ...          (:688)\n     any single identifier match is enough\n\nraw profile carries only cookie_id\n     ->  1 condition\n\nscore = matches / #conditions = 1/1 = 1.0   (:709)\n\nlink + merge on ANY match, no threshold   (:1042)\n\nties: ORDER BY score LIMIT 1 - no 'strong-id\nwins', no transitive merge of masters   (:723)","originalText":"WHERE cond1 OR cond2 OR ...          (:688)\n     any single identifier match is enough\n\nraw profile carries only cookie_id\n     ->  1 condition\n\nscore = matches / #conditions = 1/1 = 1.0   (:709)\n\nlink + merge on ANY match, no threshold   (:1042)\n\nties: ORDER BY score LIMIT 1 - no 'strong-id\nwins', no transitive merge of masters   (:723)","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#78350f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200042,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.35},

    {"type":"rectangle","id":"merged","x":1030,"y":230,"width":340,"height":230,"strokeColor":"#b91c1c","backgroundColor":"#fecaca","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200050,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"mergedt","x":1050,"y":250,"width":300,"height":195,"text":"WRONG MERGE\n\nBob's master now holds Alice's\nemail + PII (COALESCE merge).\n\nTwo real people -> one profile.\nmatch_score persisted as 1.0.\n\nNo automatic un-merge path.","originalText":"WRONG MERGE\n\nBob's master now holds Alice's\nemail + PII (COALESCE merge).\n\nTwo real people -> one profile.\nmatch_score persisted as 1.0.\n\nNo automatic un-merge path.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#7f1d1d","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200051,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.35},

