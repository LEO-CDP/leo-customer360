    {"type":"text","id":"note","x":470,"y":512,"width":900,"height":96,"text":"Related: exact match uses no normalization (case / whitespace / +country code) at\nresolver.py:590, so the same person also fragments into duplicate masters; those\nduplicates are later re-bridged by the same weak-signal OR path above.\nRoot cause: no identity-signal strength scoring.","originalText":"Related: exact match uses no normalization (case / whitespace / +country code) at\nresolver.py:590, so the same person also fragments into duplicate masters; those\nduplicates are later re-bridged by the same weak-signal OR path above.\nRoot cause: no identity-signal strength scoring.","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200070,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.35}
