    {"type":"text","id":"sql_txt","x":634,"y":632,"width":592,"height":83,"text":"INSERT INTO crm_campaign (tenant_id, campaign_code, ...)\nVALUES (:tenant, :playbook_code || '-' || :occurrence_key, ...)\nON CONFLICT (tenant_id, campaign_code) DO NOTHING\nRETURNING campaign_id;\n-- no row returned  ->  already minted  ->  skip.\n-- A double tick cannot double-send. No new machinery.","originalText":"INSERT INTO crm_campaign (tenant_id, campaign_code, ...)\nVALUES (:tenant, :playbook_code || '-' || :occurrence_key, ...)\nON CONFLICT (tenant_id, campaign_code) DO NOTHING\nRETURNING campaign_id;\n-- no row returned  ->  already minted  ->  skip.\n-- A double tick cannot double-send. No new machinery.","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200032,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},

