    {"type":"text","id":"arg_head","x":1980,"y":556,"width":340,"height":19,"text":"THE ARGUMENT","originalText":"THE ARGUMENT","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300034,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"text","id":"arg_txt","x":1980,"y":586,"width":340,"height":195,"text":"Everything dashed in this column already\nexists, is deployed, and is tested.\n\nThe recurrence layer does not touch\nactivation, channel routing, dispatch,\nthe ledger, webhooks, the S3 event lake,\nopt-out projection, or analytics.\n\nONE file changes:\nnotification_engine/rendering.py, to\nresolve param_bindings per recipient.\n\nThat is the whole blast radius.","originalText":"Everything dashed in this column already\nexists, is deployed, and is tested.\n\nThe recurrence layer does not touch\nactivation, channel routing, dispatch,\nthe ledger, webhooks, the S3 event lake,\nopt-out projection, or analytics.\n\nONE file changes:\nnotification_engine/rendering.py, to\nresolve param_bindings per recipient.\n\nThat is the whole blast radius.","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300035,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},

    {"type":"text","id":"safe_head","x":1980,"y":810,"width":340,"height":19,"text":"SEND-TIME SAFETY","originalText":"SEND-TIME SAFETY","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#b45309","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300036,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"text","id":"safe_txt","x":1980,"y":840,"width":340,"height":90,"text":"An unresolved binding writes a Skipped\nledger row. It NEVER sends a message\nwith a blank value.\n\nA ZNS message reading \"Tong diem: \" is\nworse than no message at all.","originalText":"An unresolved binding writes a Skipped\nledger row. It NEVER sends a message\nwith a blank value.\n\nA ZNS message reading \"Tong diem: \" is\nworse than no message at all.","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300037,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},

    {"type":"text","id":"occ_head","x":620,"y":1122,"width":900,"height":17,"text":"OCCURRENCE CONTRACT  —  what the tick writes into an ordinary crm_campaign row","originalText":"OCCURRENCE CONTRACT  —  what the tick writes into an ordinary crm_campaign row","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200050,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"rectangle","id":"occ_box","x":620,"y":1148,"width":900,"height":122,"strokeColor":"#334155","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200051,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"type":"text","id":"occ_txt","x":634,"y":1168,"width":872,"height":83,"text":"campaign_code    trungthu-2026-09-25        ->  UNIQUE(tenant_id, campaign_code) = idempotency\nchannel          zalo_zns                   ->  routes to notification_engine in triggers.py\ntemplate_id      <playbook.template_id>     ->  activation re-checks it is still Approved\napproval_status  Approved                   ->  inherited; InReview if copy was regenerated\nai_plan          {\"template_data\": { ... }} ->  send.py ALREADY reads ai_plan.template_data\nmetadata         { playbook_id, occurrence_key, param_bindings, use_case, fired_at }","originalText":"campaign_code    trungthu-2026-09-25        ->  UNIQUE(tenant_id, campaign_code) = idempotency\nchannel          zalo_zns                   ->  routes to notification_engine in triggers.py\ntemplate_id      <playbook.template_id>     ->  activation re-checks it is still Approved\napproval_status  Approved                   ->  inherited; InReview if copy was regenerated\nai_plan          {\"template_data\": { ... }} ->  send.py ALREADY reads ai_plan.template_data\nmetadata         { playbook_id, occurrence_key, param_bindings, use_case, fired_at }","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200052,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},

    {"type":"text","id":"phase_head","x":1600,"y":990,"width":740,"height":19,"text":"PHASED DELIVERY  —  each phase independently demoable","originalText":"PHASED DELIVERY  —  each phase independently demoable","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300060,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"text","id":"phase_txt","x":1600,"y":1022,"width":740,"height":105,"text":"P0   crm_campaign_playbook table + RLS + DAO models\nP1   playbook_api + /plan/playbook + playbook_planner prompt\nP2   playbook_tick + occurrence minting  (segment mode only)\nP3   per-recipient param bindings   <-  the ONLY send-path change\nP4   event_batch + anniversary audience modes\nP5   the same resolver imported into email_engine\nP6   playbook ops UI: next fire time, occurrence history, pause","originalText":"P0   crm_campaign_playbook table + RLS + DAO models\nP1   playbook_api + /plan/playbook + playbook_planner prompt\nP2   playbook_tick + occurrence minting  (segment mode only)\nP3   per-recipient param bindings   <-  the ONLY send-path change\nP4   event_batch + anniversary audience modes\nP5   the same resolver imported into email_engine\nP6   playbook ops UI: next fire time, occurrence history, pause","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300061,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"text","id":"phase_note","x":1600,"y":1152,"width":740,"height":45,"text":"Land P2 before P3. Occurrence minting is then proven against the\nUNMODIFIED send path, so when the send path finally changes there\nis exactly one variable in play.","originalText":"Land P2 before P3. Occurrence minting is then proven against the\nUNMODIFIED send path, so when the send path finally changes there\nis exactly one variable in play.","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#b45309","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300062,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},

