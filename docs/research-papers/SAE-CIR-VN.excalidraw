    { "type": "text", "id": "agg_l1", "x": 1620, "y": 268, "width": 720, "height": 24, "text": "S  =  Σ E_k      (evidence score, not a probability)", "originalText": "S  =  Σ E_k      (evidence score, not a probability)", "fontSize": 18, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 130005, "version": 1, "versionNonce": 130006, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "agg_l2", "x": 1620, "y": 300, "width": 720, "height": 20, "text": "calibrate to a probability  p = P(same | x)  only with labeled data", "originalText": "calibrate to a probability  p = P(same | x)  only with labeled data", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#475569", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 130007, "version": 1, "versionNonce": 130008, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
