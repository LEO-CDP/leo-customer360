# Copy to .env and fill in. Hosted or local models + pgvector on the vDB. Keep out of git.

# --- Vector store: pgvector on the VNGCloud vDB (PostgreSQL 15) ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=...
PG_USER=...
PG_PASSWORD=...          # secret
PG_SCHEMA=rag
API_PORT=8001

# --- Providers and models -------------------------------------------------------
# DEFAULT RUN CONFIGURATION: OpenAI is selected for embeddings and generation.
# Set DOCS_OPENAI_API_KEY before running `enrich`, `/search`, or `/ask`.
# Each selector can independently be: openai, gemini, or local.
DOCS_EMBEDDING_PROVIDER=openai
DOCS_LLM_PROVIDER=openai

# REQUIRED DEFAULT CREDENTIAL: set this secret to use the default OpenAI providers.
DOCS_OPENAI_API_KEY=
DOCS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DOCS_OPENAI_EMBEDDING_DIMENSIONS=384                  # reduced dimensions for pgvector
DOCS_OPENAI_API_BASE_URL=https://api.openai.com/v1
DOCS_OPENAI_REQUEST_TIMEOUT_SECONDS=120
DOCS_OPENAI_RERANK_TIMEOUT_SECONDS=8
DOCS_OPENAI_LLM_MODEL=gpt-5.6-luna

# Optional Gemini embedding provider.
DOCS_GEMINI_API_KEY=                          # secret
DOCS_GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
DOCS_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
DOCS_GEMINI_EMBEDDING_DIMENSIONS=384
DOCS_GEMINI_REQUEST_TIMEOUT_SECONDS=120
DOCS_GEMINI_LLM_MODEL=gemini-2.5-flash

# Re-ranking settings
DOCS_RERANK_ENABLED=true
DOCS_RERANK_PROVIDER=openai                       # openai (one batched API call) or local
DOCS_RERANK_MODEL=BAAI/bge-reranker-base
DOCS_OPENAI_RERANK_MODEL=gpt-4o-mini
DOCS_RERANK_OPENAI_FALLBACK=vector                # vector preserves first-stage order; local is slower
DOCS_LLM_MAX_OUTPUT_TOKENS=256


# Optional local Qwen generation. Loaded only when DOCS_LLM_PROVIDER=local.
DOCS_LOCAL_LLM_MODEL_PATH=/app/models/Qwen2.5-0.5B-Instruct-Q4_K_M.gguf
DOCS_LOCAL_LLM_CONTEXT_TOKENS=2048
DOCS_LOCAL_LLM_THREADS=2
DOCS_LOCAL_LLM_BATCH_SIZE=512
DOCS_LOCAL_LLM_GPU_LAYERS=-1
DOCS_LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DOCS_LOCAL_EMBEDDING_DIMENSIONS=384                   # must match the pgvector column

# --- Retrieval / chunking ---
RETRIEVE_TOP_N=50   # reranker candidate pool — wide so short/VN queries surface the right chunk
RERANK_TOP_K=5
CHUNK_TOKENS=400
CHUNK_OVERLAP=50
CONTEXT_CHAR_BUDGET=6000
# CORPUS_DIR=../../docs

# --- HTTP / browser access ---
# Comma-separated exact origins allowed to call the API from a browser (the static docs
# site). Server-side callers (the frontend-admin /ai proxy) are same-origin and don't need this.
CORS_ORIGINS=https://leo-cdp.github.io
# Redis-backed IP and browser rate limit for the CPU-heavy endpoints (/ask + /search).
# Applies to every caller except one presenting INTERNAL_API_SECRET. 0 disables.
ASK_RATE_MAX=10
ASK_RATE_WINDOW_SEC=60
# Trusted reverse-proxy hops that append to X-Forwarded-For (Caddy = 1). The real client is the
# Nth entry from the right; a shorter chain falls back to the direct peer and is still limited.
TRUSTED_PROXY_HOPS=1
# Shared secret identifying a trusted internal caller (the frontend-admin proxy), sent as the
# X-Internal-Auth header. EMPTY = nobody is exempt (admin traffic is rate-limited too). Set the
# SAME value as the proxy's DOCS_INTERNAL_SECRET to exempt the admin console.  # secret
INTERNAL_API_SECRET=
# Worker count. The limiter/gate are per-process, so per-worker budgets are divided by this to
# keep the aggregate near target. Run 1 worker (or add a shared store) for an exact limit.
DOCS_REDIS_HOST=docs-rate-limit-redis
DOCS_REDIS_PORT=6580
DOCS_REDIS_DB=0
DOCS_REDIS_PASSWORD=                 # leave empty for the default no-auth local Redis
DOCS_REDIS_CONNECT_TIMEOUT_SECONDS=1
DOCS_REDIS_SOCKET_TIMEOUT_SECONDS=1
# Request-parameter caps (defence against CPU amplification via huge/negative values).
TOP_N_MAX=50
TOP_K_MAX=20
QUESTION_MAX_LEN=2000
