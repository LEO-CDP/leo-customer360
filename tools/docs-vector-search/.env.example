# Copy to .env and fill in. Local models + pgvector on the vDB. Keep out of git.

# --- Vector store: pgvector on the VNGCloud vDB (PostgreSQL 15) ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=...
PG_USER=...
PG_PASSWORD=...          # secret
PG_SCHEMA=rag

# --- Local models (downloaded into ./models, persisted via a volume) ---
EMBED_MODEL=intfloat/multilingual-e5-small   # VN+EN. EN-only: BAAI/bge-small-en-v1.5
EMBED_DIM=384                                 # must match the embed model's dim
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base
QWEN_MODEL_PATH=./models/Qwen2.5-0.5B-Instruct-Q4_K_M.gguf

# --- Retrieval / chunking ---
RETRIEVE_TOP_N=20
RERANK_TOP_K=5
CHUNK_TOKENS=400
CHUNK_OVERLAP=50
CONTEXT_CHAR_BUDGET=6000
# CORPUS_DIR=../../docs

# --- HTTP / browser access ---
# Comma-separated exact origins allowed to call the API from a browser (the static docs
# site). Server-side callers (the frontend-admin /ai proxy) are same-origin and don't need this.
CORS_ORIGINS=https://leo-cdp.github.io
# Max concurrent /ask generations (serialized to protect a small box from OOM). 1 = one at a time.
ASK_MAX_CONCURRENCY=1
# Per-IP /ask rate limit for public callers (keyed on X-Forwarded-For set by Caddy). The internal
# frontend-admin proxy sends no XFF and is exempt. ASK_RATE_MAX requests per ASK_RATE_WINDOW_SEC; 0 disables.
ASK_RATE_MAX=10
ASK_RATE_WINDOW_SEC=60
