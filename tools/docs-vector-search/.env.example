# Copy to .env and fill in. Kept out of git. Runs entirely on OpenAI.

# --- OpenAI (chat + embeddings) ---
# CI provides the secret LEO_OPENAI_API_KEY and the variable LEO_OPENAI_MODEL_NAME.
# LEO_OPENAI_API_KEY=sk-...            # or set OPENAI_API_KEY instead
# LEO_OPENAI_MODEL_NAME=gpt-4.1        # chat model (overrides CHAT_MODEL below)
CHAT_MODEL=gpt-4.1
EMBED_MODEL=text-embedding-3-small     # or text-embedding-3-large

# --- Corpus + retrieval ---
# CORPUS_DIR=../../docs                 # default: <repo>/docs
TOP_K=6
HOPS=1
CONTEXT_CHAR_BUDGET=24000
