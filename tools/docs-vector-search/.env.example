# Copy to .env and fill in. Local models + pgvector on the vDB. Keep out of git.

# --- Vector store: pgvector on the VNGCloud vDB (PostgreSQL 15) ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=...
PG_USER=...
PG_PASSWORD=...          # secret
PG_SCHEMA=rag

# --- Providers and local models (downloaded into ./models, persisted via a volume) ---
# local uses fastembed + llama.cpp; openai uses the OpenAI-compatible endpoint.
DOCS_EMBEDDING_PROVIDER=local
DOCS_EMBEDDING_MODEL=intfloat/multilingual-e5-small   # VN+EN; use a 384-dim model
DOCS_EMBEDDING_DIMENSIONS=384                         # must match the pgvector column
DOCS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DOCS_OPENAI_EMBEDDING_DIMENSIONS=384                  # reduced dimensions for pgvector
DOCS_RERANK_ENABLED=true
DOCS_RERANK_MODEL=BAAI/bge-reranker-base
DOCS_LOCAL_MODEL_PATH=/app/models/Qwen2.5-0.5B-Instruct-Q4_K_M.gguf
DOCS_GENERATION_CONTEXT_TOKENS=2048
DOCS_GENERATION_MAX_TOKENS=256
DOCS_LLM_PROVIDER=local
DOCS_LLM_MODEL=gpt-5.6-luna
DOCS_LLM_THREADS=2
DOCS_LLM_BATCH_SIZE=512
DOCS_OPENAI_API_KEY=                          # secret
DOCS_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Retrieval / chunking ---
RETRIEVE_TOP_N=20
RERANK_TOP_K=5
CHUNK_TOKENS=400
CHUNK_OVERLAP=50
CONTEXT_CHAR_BUDGET=6000
# CORPUS_DIR=../../docs

# --- HTTP / browser access ---
# Comma-separated exact origins allowed to call the API from a browser (the static docs
# site). Server-side callers (the frontend-admin /ai proxy) are same-origin and don't need this.
CORS_ORIGINS=https://leo-cdp.github.io
# Max concurrent /ask generations (serialized to protect a small box from OOM). 1 = one at a time.
ASK_MAX_CONCURRENCY=1
# Per-IP rate limit for the CPU-heavy endpoints (/ask + /search). Applies to every caller
# EXCEPT one presenting INTERNAL_API_SECRET. ASK_RATE_MAX requests per ASK_RATE_WINDOW_SEC; 0 disables.
ASK_RATE_MAX=10
ASK_RATE_WINDOW_SEC=60
# Trusted reverse-proxy hops that append to X-Forwarded-For (Caddy = 1). The real client is the
# Nth entry from the right; a shorter chain falls back to the direct peer and is still limited.
TRUSTED_PROXY_HOPS=1
# Shared secret identifying a trusted internal caller (the frontend-admin proxy), sent as the
# X-Internal-Auth header. EMPTY = nobody is exempt (admin traffic is rate-limited too). Set the
# SAME value as the proxy's DOCS_INTERNAL_SECRET to exempt the admin console.  # secret
INTERNAL_API_SECRET=
# Worker count. The limiter/gate are per-process, so per-worker budgets are divided by this to
# keep the aggregate near target. Run 1 worker (or add a shared store) for an exact limit.
WEB_CONCURRENCY=1
# Request-parameter caps (defence against CPU amplification via huge/negative values).
TOP_N_MAX=50
TOP_K_MAX=20
QUESTION_MAX_LEN=2000
