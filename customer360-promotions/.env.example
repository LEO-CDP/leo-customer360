# c360 PROMOTION API
c360_PROMOTION_API_HOST=localhost
c360_PROMOTION_API_PORT=9009

#  --- C360 Tracking Service -------------------------------------------------
c360_PROMOTION_TRACKING_BASE_URL=http://localhost:8010

# ----- PostgreSQL --------------------------------------------------------
c360_PROMOTION_DB_HOST=localhost
c360_PROMOTION_DB_PORT=5432
c360_PROMOTION_DB_USER=postgres
c360_PROMOTION_DB_PASSWORD=change_me_postgres_password
c360_PROMOTION_DB_NAME=customer360
c360_PROMOTION_DB_SCHEMA=leo_ads

# ----- Redis (customer360-promotions response cache) -------------------------
c360_PROMOTION_REDIS_HOST=localhost
c360_PROMOTION_REDIS_PORT=6580
c360_PROMOTION_REDIS_DB=0
c360_PROMOTION_REDIS_PASSWORD=change_me_redis_password

# ----- Ad personalisation (specs/003-ad-personalization-engine) --------------
# Personalisation ships OFF: each tenant admin switches it on per tenant, site
# or placement through the admin API. These are service-wide defaults.

# Secret that per-tenant visitor-key secrets are derived from (HMAC-SHA-256).
# REQUIRED outside development: when unset, serving falls back to default
# ranking and logs a warning. Never commit a real value; rotate with care
# because it changes every visitor key (see docs/ad-personalization.md).
c360_PROMOTION_VISITOR_KEY_MASTER_SECRET=

# Hard time budget (ms) for the personalisation step. Past it, /serve returns
# default ranking instead of waiting or failing.
c360_PROMOTION_PERSONALIZATION_TIME_BUDGET_MS=25

# A `view` event needs at least this on-screen time (ms) and visible share.
c360_PROMOTION_VIEW_MIN_DWELL_MS=1000
c360_PROMOTION_VIEW_MIN_VISIBLE_RATIO=0.5

# Similar-visitor patterns are only published for cohorts of at least this many
# visitors, so no individual can be identified from them.
c360_PROMOTION_COHORT_MIN_SIZE=50

# Visitor affinity: recency half-life in days and the clip range of the factor.
c360_PROMOTION_AFFINITY_HALF_LIFE_DAYS=14
c360_PROMOTION_AFFINITY_WEIGHT_CLIP_MIN=0.5
c360_PROMOTION_AFFINITY_WEIGHT_CLIP_MAX=2.0

# Strength of the Beta prior (pseudo-impressions) centred on the placement baseline.
c360_PROMOTION_BETA_PRIOR_STRENGTH=20

# Redis cache lifetimes (seconds) for eligible-ad lists and resolved settings.
c360_PROMOTION_CANDIDATE_CACHE_TTL_SECONDS=60
c360_PROMOTION_SETTINGS_CACHE_TTL_SECONDS=60

# Event ingestion: events per request, in-process buffer size, and per-visitor
# rate limit (events per minute).
c360_PROMOTION_EVENT_BATCH_MAX=50
c360_PROMOTION_EVENT_BUFFER_MAX=50000
c360_PROMOTION_EVENT_RATE_LIMIT_PER_MINUTE=120

# Consent changes per visitor per minute (a legitimate visitor needs one or two).
c360_PROMOTION_CONSENT_RATE_LIMIT_PER_MINUTE=30

# Kill switch: enforce targeting rules, frequency caps, ad validity windows and
# campaign dates on ALL delivery. Set to false to restore the previous
# behaviour (status + score_weight only) while a rollout is investigated.
c360_PROMOTION_ELIGIBILITY_ENFORCED=true

# New ads receive at least this share of eligible impressions until they have
# the threshold number of impressions.
c360_PROMOTION_NEW_AD_MIN_SHARE=0.05
c360_PROMOTION_NEW_AD_IMPRESSION_THRESHOLD=1000

# Visitors with fewer qualifying events than this also use cohort patterns.
c360_PROMOTION_LOW_HISTORY_EVENT_THRESHOLD=5

# Replay window (seconds) for signed server-to-server conversion postbacks.
c360_PROMOTION_CONVERSION_REPLAY_WINDOW_SECONDS=300

# Per-tenant secrets that sign server-to-server conversion postbacks (POST /conversions):
# a JSON object mapping tenant key to secret. /conversions stays disabled (503) until set.
# Generate each with e.g. `openssl rand -hex 32`; never commit a real value or log it.
# c360_PROMOTION_CONVERSION_SECRETS={"demo":"change-me"}
