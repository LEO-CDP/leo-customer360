# LOCAL DEVELOPMENT TEMPLATE ONLY — NOT PRODUCTION-READY.
# Do not deploy these localhost or placeholder credentials.
# Production settings are assembled by
# deployments/customer360-promotions/deploy-promotions.sh from Terraform and
# protected deployment secrets. The production VKS overlay is not provisioned
# until its cluster_id is set from the real cluster.

# c360 PROMOTION API
c360_PROMOTION_ENVIRONMENT=development
c360_PROMOTION_API_HOST=localhost
c360_PROMOTION_API_PORT=9009
c360_PROMOTION_ROOT_PATH=

# JSON object mapping promotions tenant keys to unique bearer tokens.
# Leave empty until configured securely; management endpoints fail closed.
# Generate each token with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
c360_PROMOTION_MANAGEMENT_TOKENS='{}'

# ----- PostgreSQL --------------------------------------------------------
# Promotions-specific settings take precedence. For local development only,
# start.sh and PromotionsSettings fall back to the repo-level DB_* values when
# this file is symlinked to ../.env.
c360_PROMOTION_DB_HOST=localhost
c360_PROMOTION_DB_PORT=5432
c360_PROMOTION_DB_USER=postgres
c360_PROMOTION_DB_PASSWORD=change_me_postgres_password
c360_PROMOTION_DB_NAME=customer360
c360_PROMOTION_DB_SCHEMA=leo_ads
c360_PROMOTION_DB_POOL_SIZE=10
c360_PROMOTION_DB_MAX_OVERFLOW=20
c360_PROMOTION_DB_POOL_RECYCLE_SECONDS=1800
c360_PROMOTION_DB_POOL_PRE_PING=true
c360_PROMOTION_DB_ECHO_SQL=false

# ----- Redis (customer360-promotions response cache) -------------------------
c360_PROMOTION_REDIS_HOST=localhost
c360_PROMOTION_REDIS_PORT=6580
c360_PROMOTION_REDIS_DB=0
c360_PROMOTION_REDIS_PASSWORD=change_me_redis_password
c360_PROMOTION_CACHE_ENABLED=true
c360_PROMOTION_CACHE_TTL_SECONDS=60