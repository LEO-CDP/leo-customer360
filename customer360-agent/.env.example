# customer360-agent — AI Agent service config.

AGENT_API_VERSION=0.1.0

# Shared bearer token that gates /plan/* (customer360-api must send the SAME value
# as its AGENT_API_TOKEN). Blank = auth DISABLED (local dev only; /health stays open).
AGENT_API_TOKEN=

# Postgres-backed prompt store. Schema + seed are owned by customer360-database
# (database-schema.sql + init-prompt-store-seed.sql); the service reads from it.
# AGENT_DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@localhost:5432/customer360

# --- LLM (LiteLLM) -----------------------------------------------------------
# One provider-agnostic triple. The model string carries the provider:
#   gemini/<model> | openai/<model> | anthropic/<model>
#   openai/<name> + LLM_BASE_URL  ->  any local OpenAI-compatible runtime (key blank)
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=
# Blank for a hosted provider's default endpoint; set for a local/self-hosted LLM:
#   LLM_MODEL=openai/llama3.1
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_BASE_URL=

# Extra params forwarded to every litellm.completion() call, as a JSON object.
# A per-request `extra_config` is merged on top of this. Example:
# LLM_EXTRA_CONFIG={"max_tokens": 2048, "timeout": 60}
LLM_EXTRA_CONFIG=
